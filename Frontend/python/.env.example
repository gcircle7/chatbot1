MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Flask 프론트엔드 세션 서명 키
FLASK_SECRET_KEY=change-me-in-production

# chatbot_api 베이스 (auth 등 — backend_client가 경로를 붙임)
CHATBOT_API_BASE=http://localhost:8006

# 브라우저 채팅 POST 대상 (전체 URL)
CHATBOT_CHAT_URL=http://localhost:8006/chat-api

# (구) CHATBOT_API_URL 은 CHATBOT_API_BASE 로 대체됨 — 호환용으로만 인식

# 로그인 세션 유효 시간(시간)
SESSION_TTL_HOURS=24

# 로그 레벨: DEBUG(개발) | INFO(운영)
# DEBUG 시 로깅 초기화 메시지·상세 로그 출력, INFO 시 억제
LOG_LEVEL=DEBUG
