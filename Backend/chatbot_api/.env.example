MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=dbadm
MYSQL_PASSWORD=
MYSQL_DATABASE=chatbotdb

# chatbot_api 베이스 (auth 등 — backend_client가 경로를 붙임)
CHATBOT_API_BASE=http://localhost:8006

# 로그인 세션 유효 시간(시간)
SESSION_TTL_HOURS=24

# ===== Redis / 메시지 브로커 (폴링 대체용 pub/sub) =====
BROKER_TYPE=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ===== DB 커넥션 풀 =====
DB_POOL_MAX=10

# ===== 로그 레벨 =====
# DEBUG(개발) | INFO(운영) — DEBUG 시 로깅 초기화 메시지 출력
LOG_LEVEL=DEBUG
