MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# 로그인 세션 유효 시간(시간)
SESSION_TTL_HOURS=24

# ===== Redis / 메시지 브로커 (폴링 대체용 pub/sub) =====
BROKER_TYPE=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ===== DB 커넥션 풀 =====
DB_POOL_MAX=10

# ===== 로그 레벨 =====
LOG_LEVEL=DEBUG