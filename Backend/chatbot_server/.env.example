# ===== MySQL (요청/응답 큐 · 세션) =====
# chatbot_api 와 동일한 chatbotdb 를 공유한다.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=dbadm
MYSQL_PASSWORD=
MYSQL_DATABASE=chatbotdb

# ===== 챗봇 이름 (system_role 에 주입) =====
CHATBOT_NAME=고비

# ===== OpenAI (대화 생성 · 임베딩) =====
OPENAI_API_KEY=

# ===== Pinecone (장기기억 벡터 검색, 인덱스: jjinchin-memory) =====
PINECONE_API_KEY=

# ===== MongoDB (원본 대화 chats · 요약 기억 memory) =====
MONGO_CLUSTER_URI=

# ===== 웹 검색 (app/parallel_function_calling.py, 현재 메인 흐름 미연결) =====
# TAVILY_API_KEY=

# ===== Redis / 메시지 브로커 (폴링 대체용 pub/sub) =====
# BROKER_TYPE: redis (기본) | rabbitmq (추후 지원)
BROKER_TYPE=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ===== 워커 동시 처리 / 큐 정리 =====
WORKER_CONCURRENCY=4
QUEUE_GC_DAYS=1

# ===== DB 커넥션 풀 =====
DB_POOL_MAX=10
