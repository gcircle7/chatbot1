# ── MySQL ──────────────────────────────────────────────────
# MYSQL_HOST, MYSQL_PORT 는 docker-compose.yml 에서 주입
MYSQL_USER=dbadm
MYSQL_PASSWORD=your_db_password_here
MYSQL_DATABASE=chatbotdb

# ── Redis ──────────────────────────────────────────────────
# REDIS_HOST, REDIS_PORT 는 docker-compose.yml 에서 주입
REDIS_DB=0
BROKER_TYPE=redis

# ── 기타 ───────────────────────────────────────────────────
SESSION_TTL_HOURS=24
DB_POOL_MAX=10
LOG_LEVEL=INFO
