# ── Flask ──────────────────────────────────────────────────
FLASK_SECRET_KEY=change-me-to-random-string-in-production

# ── API 연결 ────────────────────────────────────────────────
# CHATBOT_API_BASE 는 docker-compose.yml 에서 주입 (http://chatbot-api:8006)
# 브라우저가 직접 호출하는 채팅 URL — 외부에서 접근 가능한 주소로 설정
# 로컬 개발: http://localhost:8006/chat-api
# 배포 서버: http://chatbot.profp.co.kr/chat-api
CHATBOT_CHAT_URL=http://localhost:8006/chat-api

# ── 기타 ───────────────────────────────────────────────────
SESSION_TTL_HOURS=24
LOG_LEVEL=INFO
