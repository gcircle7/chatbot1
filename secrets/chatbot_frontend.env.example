# ── Flask ──────────────────────────────────────────────────
FLASK_SECRET_KEY=change-me-to-random-string-in-production

# ── API 연결 ────────────────────────────────────────────────
# CHATBOT_API_BASE 는 docker-compose.yml 에서 주입 (http://chatbot-api:8006)
# 브라우저가 직접 호출하는 채팅 URL — 외부에서 접근 가능한 주소로 설정
# APP_ENV: development(기본, localhost 자동 사용) | production
APP_ENV=development

# APP_PUBLIC_URL: production 시 브라우저가 접근하는 공개 도메인 (필수)
# APP_PUBLIC_URL=http://chatbot.profp.co.kr

# CHATBOT_CHAT_URL: 직접 지정 시 APP_ENV/APP_PUBLIC_URL 보다 우선 (선택)
# CHATBOT_CHAT_URL=http://chatbot.profp.co.kr/chat-api

# ── 기타 ───────────────────────────────────────────────────
SESSION_TTL_HOURS=24
LOG_LEVEL=INFO
