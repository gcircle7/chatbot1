# ── MySQL ──────────────────────────────────────────────────
MYSQL_USER=dbadm
MYSQL_PASSWORD=your_db_password_here
MYSQL_DATABASE=chatbotdb

# ── Redis ──────────────────────────────────────────────────
REDIS_DB=0
BROKER_TYPE=redis

# ── OpenAI ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Pinecone ───────────────────────────────────────────────
PINECONE_API_KEY=pcsk_...

# ── MongoDB ────────────────────────────────────────────────
MONGO_CLUSTER_URI=mongodb+srv://...

# ── 챗봇 설정 ───────────────────────────────────────────────
CHATBOT_NAME=고비
WORKER_CONCURRENCY=4
QUEUE_GC_DAYS=1
DB_POOL_MAX=10
LOG_LEVEL=INFO
